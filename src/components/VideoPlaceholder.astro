---
/* Quando houver vídeo, passe youtubeId="XXXXXXXX" e o embed real substitui o cartaz. */
interface Props { youtubeId?: string; title?: string }
const { youtubeId, title = 'IDFT — Projeto Diagonal: o Pará em perspectiva' } = Astro.props;
---
{youtubeId ? (
  <div class="video">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </div>
) : (
  <div class="video video--poster" role="img" aria-label="Espaço reservado para o vídeo de apresentação do Projeto Diagonal">
    <div class="poster__top">
      <img src="/img/idft-symbol.png" alt="" width="36" height="36" />
      <span>{title}</span>
    </div>
    <div class="poster__art">
      <div class="poster__copy">
        <span class="eyebrow eyebrow--lime">Projeto Diagonal</span>
        <span class="poster__title">O Pará em perspectiva.</span>
        <span class="poster__sub">Recursos públicos. Decisões. Consequências.</span>
      </div>
      <img class="poster__collage" src="/img/passaro-editorial.jpg" alt="" width="1400" height="933" loading="lazy" />
    </div>
    <span class="poster__play" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="#F3EFE5"><path d="M7 4.5v15l12-7.5z"/></svg></span>
    <div class="poster__bottom">
      <div class="poster__timeline"><span></span></div>
      <div class="poster__controls"><span>0:00 / 0:00 · Vídeo de apresentação · em breve</span><span>Assistir em tela cheia</span></div>
    </div>
  </div>
)}

<style>
  .video { position: relative; width: 100%; aspect-ratio: 16 / 9; background: var(--ink); border-radius: var(--radius); overflow: hidden; color: var(--paper); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .poster__top { position: absolute; left: 0; right: 0; top: 0; z-index: 2; display: flex; align-items: center; gap: 14px; padding: 20px 28px; font-size: 15px; font-weight: 600; background: linear-gradient(rgba(21,23,30,.85), rgba(21,23,30,0)); }
  .poster__top img { width: 36px; height: 36px; border-radius: 999px; border: 1px solid rgba(243,239,229,.4); }
  .poster__art { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 4%; padding: 8% 7.5%; }
  .poster__copy { display: flex; flex-direction: column; gap: 18px; position: relative; z-index: 1; }
  .poster__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 5vw, 72px); line-height: .96; letter-spacing: -0.025em; }
  .poster__sub { font-size: clamp(12px, 1.2vw, 17px); line-height: 1.5; color: var(--muted-2); max-width: 360px; }
  .poster__collage { width: 100%; max-width: 480px; justify-self: end; border: 12px solid var(--paper); transform: rotate(-5deg); box-shadow: 10px 18px 0 var(--blue); }
  .poster__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 96px; height: 66px; border-radius: 18px; background: var(--red); display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 36px rgba(0,0,0,.35); z-index: 3; }
  .poster__bottom { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 28px 28px 18px; display: flex; flex-direction: column; gap: 14px; background: linear-gradient(rgba(21,23,30,0), rgba(21,23,30,.8)); }
  .poster__timeline { height: 3px; background: rgba(243,239,229,.3); position: relative; }
  .poster__timeline span { position: absolute; left: 0; top: 0; width: 2%; height: 100%; background: var(--red); }
  .poster__controls { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted-2); }
  @media (max-width: 800px) {
    .poster__top { padding: 10px 12px; font-size: 11px; gap: 8px; }
    .poster__top img { width: 22px; height: 22px; }
    .poster__collage { border-width: 5px; box-shadow: 4px 8px 0 var(--blue); }
    .poster__play { width: 60px; height: 42px; border-radius: 11px; }
    .poster__bottom { padding: 14px 12px 10px; gap: 8px; }
    .poster__controls span:last-child { display: none; }
    .poster__art { grid-template-columns: 1fr; padding: 14% 8% 16%; }
    .poster__collage { display: none; }
    .poster__copy { gap: 8px; }
  }
</style>
