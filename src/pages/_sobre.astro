---
import Base from '../layouts/Base.astro';
---
<Base title="Sobre o IDFT · IDFT" description="O Instituto pelo Desenvolvimento Fiscal e Transparência é uma organização da sociedade civil, apartidária, dedicada a compreender como o Estado arrecada e gasta — e a agir sobre o que encontra.">
  <section class="section">
    <div class="container pagina">
      <span class="eyebrow">Instituto</span>
      <h1 class="display-xl">Sobre o IDFT</h1>
      <p class="lead">O Instituto pelo Desenvolvimento Fiscal e Transparência é uma organização da sociedade civil, apartidária, dedicada a compreender como o Estado arrecada e gasta — e a agir sobre o que encontra.</p>
      <div class="corpo">
        <h2 id="equipe">Equipe e conselho</h2><p>Em preparação.</p>
        <h2 id="transparencia">Transparência do IDFT</h2><p>Estatuto, demonstrações e fontes de financiamento serão publicados nesta seção.</p>
        <h2 id="imprensa">Imprensa</h2><p>Contato: <a href="mailto:idft.br@proton.me">idft.br@proton.me</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .pagina { max-width: 860px; display: flex; flex-direction: column; gap: 20px; }
  .corpo { display: flex; flex-direction: column; gap: 20px; margin-top: 16px; }
  .corpo :global(h2) { font-size: 28px; margin-top: 24px; padding-bottom: 10px; border-bottom: 2px solid var(--ink); }
  .corpo :global(p), .corpo :global(li) { font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  .corpo :global(.item) { display: flex; flex-direction: column; gap: 8px; padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .corpo :global(.item h3) { font-size: 24px; }
  .corpo :global(.nota) { background: var(--paper-2); border-left: 4px solid var(--lime); padding: 14px 18px; border-radius: 6px; }
</style>
