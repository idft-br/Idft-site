---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
const temas = (await getCollection('temas')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Os 12 temas — Projeto Diagonal · IDFT" description="Doze frentes de investigação sobre o dinheiro público do Pará: visão geral, transparência, saúde, organização central, municípios, educação, saneamento, Bora Belém, campo, Banpará, mundo jurídico e impunidade.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Início / Temas</span>
          <h1 class="display-xl">Doze frentes de investigação</h1>
        </div>
        <p>Do orçamento aos serviços essenciais, do território às instituições de controle: doze temas para conectar informações, formular perguntas e acompanhar a atuação do Estado.</p>
      </div>
      <div class="grid">
        {temas.map((t) => (
          <a href={`/temas/${t.id}`} class="tile">
            <div class="tile__imgwrap">
              <img class="tile__img" src={t.data.ampla} alt={t.data.alt} width="1200" height="800" loading="lazy" />
              <img class="tile__selo" src={t.data.compacta} alt="" width="320" height="320" loading="lazy" />
            </div>
            <div class="tile__text">
              <span class="eyebrow">Tema {t.data.n}</span>
              <span class="tile__title">{t.data.title}</span>
              <span class="tile__line">{t.data.line}</span>
              <span class="link-arrow">Ver tema <Arrow /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 32px; }
  .tile { display: flex; flex-direction: column; gap: 18px; color: var(--ink); }
  .tile__imgwrap { position: relative; padding: 0 8px 22px 0; }
  .tile__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; box-shadow: 6px 6px 0 var(--ink); transition: transform .2s ease, box-shadow .2s ease; }
  .tile:hover .tile__img { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ink); }
  .tile__selo { position: absolute; left: -12px; bottom: 0; width: 72px; height: 72px; object-fit: cover; }
  .tile__text { display: flex; flex-direction: column; gap: 8px; padding-left: 68px; }
  .tile__title { font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.15; }
  .tile__line { font-size: 15px; line-height: 1.45; color: var(--muted); }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; gap: 40px; } .tile__text { padding-left: 0; } .tile__selo { display: none; } }
</style>
