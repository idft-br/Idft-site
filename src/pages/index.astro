---
// Home V3 (layout B++). Os textos vêm de src/data/home.json, extraído do canvas de design.
import Site from '../layouts/Site.astro';
import Passaro from '../components/b/Passaro.astro';
import Seta from '../components/b/Seta.astro';
import home from '../data/home.json';

const { hero, diagonal, temas, videos, iniciativas, canal, dados, boletim } = home;

// Marcadores de rascunho do canvas: "[Breve]" vira o selo "Em breve"; " · [nome]" sai do rótulo.
const breve = (s: string) => ({ texto: s.replace(/\s*\[Breve\]\s*/i, ' ').trim(), breve: /\[Breve\]/i.test(s) });
const semNome = (s: string) => s.replace(/\s*·\s*\[nome\]/i, '').trim();
const img = (nome: string, w: number) => `/img/home/tema-${nome}-${w}.webp`;
const grupos = [temas.cards.slice(0, 4), temas.cards.slice(4, 8), temas.cards.slice(8, 12)];
const canalBotao = breve(canal.botoes[0]);
const dadosTitulo = breve(dados.titulo);

const PASSARO = ['32,25 113.5,58.5 82.5,115', '113.5,58.5 155.5,134 82.5,115', '128.9,86.2 159.5,60.5 155.5,134',
  '159.5,60.5 195.5,80.3 159,98', '82.5,115 155.5,134 113.5,176.5', '82.5,115 113.5,176.5 66.5,224.5'];
const PASSARO_COR = ['#4B86E6', '#1755C5', '#0B2A6B', '#4B86E6', '#8FB4F0', '#1755C5'];
const AVIAO = ['650,35 143,260 410,210', '143,260 410,210 285,312', '410,210 285,312 305,412 378,335', '410,210 378,335 482,442',
  '410,210 445,236 482,442', '650,35 410,210 445,236', '650,35 445,236 482,442'];
const AVIAO_COR = ['#4B86E6', '#BBD2F6', '#1755C5', '#DCE8FB', '#8FB4F0', '#DCE8FB', '#6FA0EC'];

const title = 'IDFT — Instituto pelo Desenvolvimento Fiscal e Transparência';
const description = 'Entender o que o Estado arrecada e gasta é o passo 01 de um futuro digno. Investigações, dados e iniciativas sobre o dinheiro público no Pará.';
---
<Site title={title} description={description}>

  <section class="abertura" aria-labelledby="abertura-t">
    <svg class="abertura__faceta" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polygon points="34,0 100,0 100,100 0,100" fill="#DCE8FB" /></svg>
    <div class="wrap abertura__in">
      <div class="abertura__texto">
        <span class="chip chip--branco cut-s">{hero.chip}</span>
        <h1 id="abertura-t" class="h1" set:html={hero.titulo} />
        <p class="lead" set:html={hero.texto} />
        <div class="botoes"><a href="#diagonal" class="btn btn--azul cut">{hero.botao}<Seta /></a></div>
      </div>
      <div class="abertura__passaro">
        <Passaro contorno="#EEF3FB" espessura={1.6} rotulo="Pássaro de origami do IDFT em facetas azuis" />
      </div>
    </div>
  </section>

  <section id="diagonal" class="diagonal" aria-labelledby="diagonal-t">
    <div class="wrap diagonal__in">
      <div class="diagonal__texto">
        <span class="chip cut-s">{diagonal.chip}</span>
        <h2 id="diagonal-t" class="h2" set:html={diagonal.titulo} />
        <p class="lead" set:html={diagonal.texto} />
        <div class="botoes">
          <a href="#iniciativas" class="btn btn--azul cut">{diagonal.botoes[0]}</a>
          <a href="#dados" class="btn btn--nevoa cut">{diagonal.botoes[1]}</a>
        </div>
      </div>
      <div class="diagonal__arte">
        <svg viewBox="0 0 720 560" role="img" aria-label="Pássaro de origami do IDFT e o avião de papel do Projeto Diagonal subindo juntos a mesma faixa diagonal">
          <polygon points="61.2,376.6 540.4,15.5 654.7,167.2 175.5,528.3" fill="#EEF3FB" />
          <path d="M130.4 443.4 L533.7 139.5" fill="none" stroke="#8FB4F0" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 11" />
          <g transform="translate(61.52 206.74) scale(1.5)" stroke="#FFFFFF" stroke-width="1.4" stroke-linejoin="round">
            {PASSARO.map((p, i) => <polygon points={p} fill={PASSARO_COR[i]} />)}
          </g>
          <g transform="translate(328.41 23.64) scale(0.48)" stroke="#FFFFFF" stroke-width="4.4" stroke-linejoin="round">
            {AVIAO.map((p, i) => <polygon points={p} fill={AVIAO_COR[i]} />)}
          </g>
        </svg>
      </div>
    </div>
    <div class="wrap numeros-wrap">
      <div class="numeros">
        {diagonal.numeros.map((n) => (
          <div class="numero"><div class="numero__n">{n.n}</div><div class="numero__l" set:html={n.l} /></div>
        ))}
        <div class="numero numero--data">{diagonal.atualizado}</div>
      </div>
    </div>
  </section>

  <section id="temas" class="wrap temas" aria-labelledby="temas-t">
    <div class="temas__topo">
      <h2 id="temas-t" class="secao-titulo">{temas.titulo}</h2>
      <p set:html={temas.texto} />
    </div>
    {grupos.map((g) => (
      <div class="temas__grupo">
        {g.map((t) => (
          <article class="tema">
            <img src={img(t.img, 600)} srcset={`${img(t.img, 240)} 240w, ${img(t.img, 600)} 600w, ${img(t.img, 1200)} 1200w`} sizes="(max-width: 640px) 108px, (max-width: 1080px) 46vw, 270px" width="600" height="400" alt="" loading="lazy" decoding="async" />
            <div class="tema__cab"><span class="tema__n">{t.n}</span><h3 class="tema__t" set:html={t.titulo} /></div>
            <p class="tema__l" set:html={t.linha} />
          </article>
        ))}
      </div>
    ))}
  </section>

  <section id="videos" class="videos" aria-labelledby="videos-t">
    <div class="wrap videos__in">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <span class="mono">{videos.rotulo}</span>
        <h2 id="videos-t" class="videos__titulo">{videos.titulo}</h2>
      </div>
      <div class="videos__destaque">
        <div class="capa capa--grande">
          <img src={img(videos.destaque.img, 1200)} alt="" width="1200" height="800" loading="lazy" decoding="async" />
          <span class="capa__topo"><b>{videos.destaque.topo[0]}</b><i>{videos.destaque.topo[1]}</i><s></s></span>
          <span class="capa__frase">{videos.destaque.capa.map((l, i) => i === 1 ? <mark set:html={l} /> : <span set:html={l} />)}</span>
          <span class="capa__base">{videos.destaque.base}</span>
          <span class="capa__breve">EM BREVE</span>
        </div>
        <div class="videos__info">
          <span class="mono">{videos.destaque.rotulo}</span>
          <h3 set:html={videos.destaque.titulo} />
          <p set:html={videos.destaque.texto} />
        </div>
      </div>
      <div class="videos__sep"></div>
      <div class="videos__outros">
        {videos.outros.map((v) => (
          <article class="video">
            <div class="capa">
              <img src={img(v.img, 600)} alt="" width="600" height="400" loading="lazy" decoding="async" />
              <span class="capa__marca">IDFT</span>
              <span class="capa__frase">{v.capa.map((l, i) => (i === 1 && !l.includes('<mark>')) ? <mark set:html={l} /> : <span set:html={l} />)}</span>
              <span class="capa__breve">EM BREVE</span>
            </div>
            <span class="mono" style="font-size: 11px">{v.rotulo}</span>
            <h3 class="video__t" style="margin: 0" set:html={v.titulo} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="iniciativas" class="wrap iniciativas" aria-labelledby="iniciativas-t">
    <div class="secao-cab">
      <div><span class="mono">{iniciativas.rotulo}</span><h2 id="iniciativas-t" class="secao-titulo">{iniciativas.titulo}</h2></div>
    </div>
    <div class="iniciativas__grade">
      {iniciativas.itens.map((it) => (
        <article class="iniciativa">
          <div class="iniciativa__cab">
            <img src={`/img/home/${it.img}.webp`} alt="" width="88" height="88" loading="lazy" decoding="async" />
            <span class="iniciativa__r">{semNome(it.rotulo)}</span>
          </div>
          <h3 set:html={it.titulo} />
          <p set:html={it.texto} />
        </article>
      ))}
    </div>
  </section>

  <section id="canal" class="canal" aria-labelledby="canal-t">
    <svg class="canal__faceta" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polygon points="34,0 100,0 100,100 0,100" fill="#13233B" /></svg>
    <div class="wrap canal__in">
      <div class="canal__texto">
        <span class="mono canal__rot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 8.2-8 9-4.8-.8-8-4.5-8-9V6l8-3z" /><path d="M9 12l2 2 4-4" /></svg>{canal.rotulo}</span>
        <h2 id="canal-t">{canal.titulo}</h2>
        <p set:html={canal.texto} />
        <div class="canal__marcas">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>{canal.marcas[0]}</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18" /><path d="M10.6 10.6a3 3 0 0 0 4.2 4.2" /><path d="M9.9 5.1A10.5 10.5 0 0 1 12 5c5 0 9 4 10 7-.5 1.3-1.4 2.7-2.7 3.9" /><path d="M6.1 6.1C4 7.5 2.6 9.5 2 12c1 3 5 7 10 7 1.5 0 2.9-.3 4.1-.9" /></svg>{canal.marcas[1]}</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 8.2-8 9-4.8-.8-8-4.5-8-9V6l8-3z" /><path d="M9 12l2 2 4-4" /></svg>{canal.marcas[2]}</span>
        </div>
      </div>
      <div class="canal__acao">
        <div class="canal__botao cut"><span>{canalBotao.texto}</span>{canalBotao.breve && <span class="breve">Em breve</span>}</div>
      </div>
    </div>
  </section>

  <section id="dados" class="wrap dados" aria-labelledby="dados-t">
    <div class="secao-cab">
      <div>
        <span class="mono">{dados.rotulo}</span>
        <h2 id="dados-t" class="secao-titulo">{dadosTitulo.texto} {dadosTitulo.breve && <span class="breve" style="vertical-align: middle">Em breve</span>}</h2>
      </div>
      <span class="dados__nota">{dados.nota}</span>
    </div>
    <div class="dados__grade">
      {dados.paineis.map((p) => <div class="painel">{p}<Seta cor="#1755C5" /></div>)}
    </div>
  </section>

  <section class="boletim" aria-labelledby="boletim-t">
    <div class="wrap boletim__in">
      <div class="boletim__texto">
        <h2 id="boletim-t" class="boletim__t" style="margin: 0">{boletim.titulo}</h2>
        <span class="boletim__s">{boletim.texto}</span>
      </div>
      <form action="mailto:idft.br@proton.me?subject=Quero%20receber%20o%20boletim%20do%20IDFT" method="post" enctype="text/plain">
        <label for="boletim-email" class="sr-only">Seu e-mail</label>
        <input id="boletim-email" name="email" type="email" placeholder={boletim.placeholder} autocomplete="email" required />
        <button type="submit">{boletim.botao}</button>
      </form>
    </div>
  </section>

</Site>
