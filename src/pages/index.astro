---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import TemaCard from '../components/TemaCard.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import CanalSeguro from '../components/CanalSeguro.astro';
import Boletim from '../components/Boletim.astro';

const temas = (await getCollection('temas')).sort((a, b) => a.data.order - b.data.order);
const destaque = temas[0]; // Tema 01 · Visão geral
---
<Base title="IDFT — Clareza sobre o dinheiro público do Pará">

  <!-- abertura institucional -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="eyebrow">Um futuro melhor só pode ser escrito a muitas mãos</span>
        <h1 class="display-xl hero__title">Compreender quanto o Estado arrecada e como gasta é essencial para um futuro melhor</h1>
        <p class="lead">Sem informação o debate público se perde em afirmações vazias, afastando o estímulo para que os governantes busquem o voto através da melhoria da vida da coletividade.</p>
        <p class="lead">Atuamos na interseção entre o direito, a economia e a política, visando garantir que os recursos <i>públicos</i> sirvam ao interesse <i>público</i>.</p>
        <div class="hero__actions">
          <a href="#diagonal" class="btn btn--blue">Conheça nossa atuação <Arrow color="#D3E33A" size={18} /></a>
        </div>
      </div>
      <div class="hero__art">
        <img src="/img/passaro-editorial.jpg" alt="Pássaro de origami em colagem: papel azul, círculo verde-limão e um traço de tinta em arco" width="1400" height="933" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- faixa dos 12 temas (imagens compactas) -->
  <section class="faixa rule-top" aria-label="Atalhos para os 12 temas">
    <div class="container">
      <div class="faixa__head">
        <span class="eyebrow eyebrow--muted">Projeto Diagonal · 12 perspectivas</span>
        <a href="/temas" class="link-arrow">Todos os temas <Arrow size={14} /></a>
      </div>
      <div class="faixa__grid">
        {temas.map((t) => (
          <a href={`/temas/${t.id}`} class="chip">
            <img src={t.data.compacta} alt={t.data.alt} width="320" height="320" loading="lazy" />
            <span>{t.data.short}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- projeto diagonal -->
  <section id="diagonal" class="section diagonal">
    <div class="container diagonal__grid">
      <div class="diagonal__text">
        <span class="eyebrow">Primeiro foco de atuação / caso mais extremo</span>
        <h2 class="display-l">Projeto <i>Diagonal</i></h2>
        <p><b><i>Um estado em perspectiva</i></b>. O primeiro enfoque do IDFT é a exposição dos aspectos únicos da armadilha local e das ações já adotadas no seu enfrentamento, buscando a construção de caminhos.</p>
        <p><b><i>Arrecadação recorde, abandono histórico</i></b>: um estado que dobrou o nível real de receitas e mais que dobrou o de gastos, mas a sobra não se reverte em melhorias e as razões seguem protegidas no vazio do debate público.</p>
        <div class="stats">
          <div class="stat"><span class="stat__n">98%</span><span class="stat__l">aumento real da arrecadação (IPCA)</span></div>
          <div class="stat"><span class="stat__n">+150%</span><span class="stat__l">aumento do valor pago às OSS em 3 anos</span></div>
          <div class="stat"><span class="stat__n">0</span><span class="stat__l">aumento no volume de serviços prestados</span></div>
        </div>
      </div>
      <div class="diagonal__art">
        <img src="/img/projeto-diagonal.webp" alt="Avião de papel em colagem: papel azul e círculo verde-limão" width="1536" height="1024" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- grade dos 12 temas -->
  <section id="temas" class="section temas">
    <div class="container">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Projeto Diagonal / 12 perspectivas</span>
          <h2 class="display-l">Por onde você quer começar?</h2>
        </div>
        <p>Cada tema abre com a colagem, a frase que o orienta e os materiais reunidos: investigações, peças jurídicas e bases de dados.</p>
      </div>
      <div class="temas__grid">
        {temas.map((t) => (
          <TemaCard n={t.data.n} title={t.data.title} line={t.data.line} ampla={t.data.ampla} alt={t.data.alt} href={`/temas/${t.id}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- vídeo de apresentação -->
  <section id="video" class="section video-section">
    <div class="container">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Para ver e compreender</span>
          <h2 class="display-m">Conheça o Projeto Diagonal.</h2>
        </div>
        <p class="video-note">Vídeo de apresentação · em breve</p>
      </div>
      <VideoPlaceholder />
    </div>
  </section>

  <!-- destaque: tema 01 -->
  <section class="band band--blue destaque" aria-labelledby="destaque-title">
    <div class="container destaque__grid">
      <div class="destaque__text">
        <span class="eyebrow eyebrow--lime">Em destaque · Tema {destaque.data.n} · {destaque.data.title}</span>
        <h2 id="destaque-title" class="display-l">Arrecadação excepcional, duplicação de gastos e a desvalorização do voto</h2>
        <p>O paradoxo de bonança: o estado de maior incremento de arrecadação em todo o país mais que dobra os gastos, mas segue com a pior saúde e educação do Brasil — os efeitos materiais sobre o povo da política de controle sobre os controles.</p>
        <div class="destaque__actions">
          <a href={`/temas/${destaque.id}`} class="btn btn--lime">Abrir o tema <Arrow /></a>
          <a href={`/temas/${destaque.id}#linha-do-tempo`} class="destaque__link">Ver a linha do tempo</a>
        </div>
      </div>
      <div class="destaque__art">
        <img src={destaque.data.ampla} alt={destaque.data.alt} width="1200" height="800" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- iniciativas -->
  <section id="iniciativas" class="section iniciativas">
    <div class="container">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Da análise à atuação</span>
          <h2 class="display-m">Iniciativas</h2>
        </div>
        <a href="/iniciativas" class="link-arrow">Ver as 10 iniciativas <Arrow size={14} /></a>
      </div>
      <div class="iniciativas__grid">
        <a href="/iniciativas#acao-popular-2020" class="card">
          <img src="/img/temas/02-transparencia-compacta.jpg" alt="" width="320" height="320" loading="lazy" />
          <span class="eyebrow">A primeira Ação Popular, em 2020</span>
          <span class="card__title">A primeira Ação Popular</span>
          <span class="card__text">Conheça o conteúdo de uma ação que poderia ter evitado o dano coletivo, e as razões pelas quais o Judiciário segue se recusando a analisar o levantamento do sigilo.</span>
        </a>
        <a href="/iniciativas#orcrim-2022" class="card">
          <img src="/img/temas/11-controle-juridico-compacta.jpg" alt="" width="320" height="320" loading="lazy" />
          <span class="eyebrow">Iniciativa 2</span>
          <span class="card__title">A exposição da ORCRIM em 2022, que gerou a <i>Operação Fratria</i></span>
          <span class="card__text">Um retrato minucioso e profundo da atuação que inviabiliza qualquer expectativa de um futuro melhor.</span>
        </a>
        <a href="/iniciativas#notas-tecnicas-cgu" class="card">
          <img src="/img/temas/04-nucleo-compacta.jpg" alt="" width="320" height="320" loading="lazy" />
          <span class="eyebrow">Iniciativa 3</span>
          <span class="card__title">As Notas Técnicas da CGU</span>
          <span class="card__text">Veja as 6 Notas Técnicas da CGU, que confirmam todas as ilegalidades apontadas na denúncia.</span>
        </a>
      </div>
    </div>
  </section>

  <CanalSeguro />

  <!-- dados -->
  <section id="dados" class="section--tight dados">
    <div class="container">
      <div class="section-head dados__head">
        <div class="stack">
          <span class="eyebrow">Dados</span>
          <h2 class="display-m">Painéis e bases para consulta</h2>
        </div>
        <p class="dados__note">Em preparação · exportação em CSV e Excel</p>
      </div>
      <div class="dados__grid">
        {['Arrecadação', 'Despesas', 'Dados sociais', 'Outros'].map((d) => (
          <a href={`/dados#${d.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-')}`} class="tile">{d} <Arrow size={20} /></a>
        ))}
      </div>
    </div>
  </section>

  <Boletim />
</Base>

<style>
  /* herói */
  .hero { padding: 64px 0 40px; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 40px; align-items: center; }
  .hero__title { font-size: clamp(38px, 4.2vw, 60px); }
  .hero__text { display: flex; flex-direction: column; gap: 24px; }
  .hero__text .lead { max-width: 600px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
  .hero__art img { width: 100%; max-width: 620px; margin: 0 auto; }

  /* faixa de atalhos */
  .faixa { padding: 12px 0 24px; }
  .faixa__head { display: flex; align-items: center; justify-content: space-between; margin: 12px 0 14px; }
  .faixa__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; }
  .chip { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; color: var(--ink); }
  .chip img { width: 84px; height: 84px; object-fit: cover; transition: transform .2s ease; }
  .chip:hover img { transform: scale(1.08); }
  .chip span { font-size: 11px; font-weight: 600; line-height: 1.15; letter-spacing: 0.02em; }

  /* projeto diagonal */
  .diagonal__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; }
  .diagonal__text { display: flex; flex-direction: column; gap: 22px; }
  .diagonal__text p { font-size: 18px; line-height: 1.55; color: var(--muted); }
  .diagonal__art img { width: 100%; max-width: 660px; margin: 0 0 0 auto; }
  .stats { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 6px; }
  .stat { display: flex; flex-direction: column; gap: 4px; border-left: 3px solid var(--lime); padding-left: 14px; flex: 1 1 150px; max-width: 200px; }
  .stat__n { font-family: var(--font-display); font-weight: 800; font-size: 32px; line-height: 1; }
  .stat__l { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }

  /* temas */
  .temas__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 44px 32px; }

  /* vídeo */
  .video-section { padding-top: 40px; }
  .video-note { font-size: 13px; color: var(--muted); }

  /* destaque */
  .destaque { padding: 72px 0; }
  .destaque__grid { display: grid; grid-template-columns: 1fr 600px; gap: 56px; align-items: center; }
  .destaque__text { display: flex; flex-direction: column; gap: 20px; }
  .destaque__text h2 { color: var(--paper); }
  .destaque__text p { font-size: 18px; line-height: 1.5; color: var(--blue-soft); max-width: 560px; }
  .destaque__actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 6px; }
  .destaque__link { color: var(--paper); font-weight: 700; border-bottom: 2px solid var(--lime); padding: 14px 8px; }
  .destaque__link:hover { color: var(--lime); }
  .destaque__art img { width: 100%; border-radius: 4px; box-shadow: 14px 14px 0 var(--ink); transform: rotate(-1.5deg); }

  /* iniciativas */
  .iniciativas__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .card { display: flex; flex-direction: column; gap: 14px; padding: 24px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-3); color: var(--ink); transition: transform .15s ease, border-color .15s ease; }
  .card:hover { transform: translateY(-3px); border-color: var(--ink); color: var(--ink); }
  .card img { width: 88px; height: 88px; object-fit: cover; border-radius: 8px; }
  .card__title { font-family: var(--font-display); font-weight: 700; font-size: 22px; line-height: 1.1; }
  .card__text { font-size: 14px; line-height: 1.5; color: var(--muted); }

  /* dados */
  .dados { padding: 40px 0 64px; border-top: 1px solid var(--rule); }
  .dados__head { margin-bottom: 24px; }
  .dados__note { font-size: 13px; }
  .dados__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .tile { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 22px; border: 1.5px solid var(--ink); border-radius: var(--radius); font-family: var(--font-display); font-weight: 700; font-size: 22px; min-height: 76px; color: var(--ink); transition: background .15s, color .15s; }
  .tile:hover { background: var(--ink); color: var(--paper); }
  .tile:hover :global(svg) { color: var(--lime); }

  @media (max-width: 1100px) {
    .temas__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .faixa__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px 8px; }
    .destaque__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .dados__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 800px) {
    .hero { padding: 28px 0 16px; }
    .hero__grid, .diagonal__grid, .destaque__grid { grid-template-columns: 1fr; gap: 24px; }
    .hero__actions .btn { width: 100%; }
    .diagonal__art img { margin: 0 auto; }
    .temas__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
    .iniciativas__grid { grid-template-columns: 1fr; }
    .destaque__art img { transform: none; box-shadow: 8px 8px 0 var(--ink); }
    .chip img { width: 52px; height: 52px; }
    .chip span { font-size: 9px; }
  }
</style>
