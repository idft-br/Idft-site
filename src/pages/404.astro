---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada · IDFT">
  <section class="section"><div class="container" style="display:flex;flex-direction:column;gap:20px;max-width:760px">
    <span class="eyebrow">Erro 404</span>
    <h1 class="display-xl">Esta página não existe.</h1>
    <p class="lead">O endereço pode ter mudado. Volte à <a href="/" style="color:var(--blue);text-decoration:underline">página inicial</a> ou abra <a href="/temas" style="color:var(--blue);text-decoration:underline">os 12 temas</a>.</p>
  </div></section>
</Base>
