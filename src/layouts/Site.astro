---
// Layout B++ (Home V3). Fontes servidas pelo próprio site (sem Google Fonts).
import '@fontsource-variable/red-hat-display/wght.css';
import '@fontsource-variable/red-hat-display/wght-italic.css';
import '@fontsource-variable/red-hat-text/wght.css';
import '@fontsource-variable/red-hat-text/wght-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/site.css';
import Passaro from '../components/b/Passaro.astro';
import home from '../data/home.json';

interface Props { title: string; description: string; image?: string }
const { title, description, image = '/img/og-idft.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const base = isHome ? '' : '/';
const nav = [
  ['Projeto Diagonal', '#diagonal'],
  ['Temas', '#temas'],
  ['Dados', '#dados'],
  ['Vídeos', '#videos'],
];
const r = home.rodape;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IDFT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1755C5" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: 'IDFT — Instituto pelo Desenvolvimento Fiscal e Transparência',
      alternateName: 'IDFT',
      url: 'https://idft.com.br',
      logo: 'https://idft.com.br/apple-touch-icon.png',
      email: 'idft.br@proton.me',
      areaServed: 'Pará, Brasil',
    })} />
  </head>
  <body>
    <a class="sr-only" href="#conteudo">Ir para o conteúdo</a>
    <header class="topo">
      <div class="wrap topo__in">
        <a href="/" class="marca" aria-label="IDFT — página inicial"><Passaro /><span>IDFT</span></a>
        <nav class="nav" aria-label="Seções da página">
          {nav.map(([t, h]) => <a href={base + h}>{t}</a>)}
          <a href={base + '#iniciativas'} class="nav__cta">Iniciativas</a>
        </nav>
        <details class="menu">
          <summary aria-label="Abrir o menu"><svg viewBox="0 0 20 20" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg></summary>
          <nav class="menu__painel" aria-label="Seções da página">
            {nav.map(([t, h]) => <a href={base + h}>{t}</a>)}
            <a href={base + '#iniciativas'}>Iniciativas</a>
            <a href={base + '#canal'}>Canal seguro</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="rodape">
      <div class="wrap rodape__in">
        <div class="rodape__grade">
          <div class="rodape__marca">
            <a href="/" aria-label="IDFT — página inicial"><Passaro variante="claro" contorno="#10213F" /><b>IDFT</b></a>
            <span>{r.instituto}</span>
          </div>
          <div class="rodape__col">
            <span class="mono">Projeto Diagonal</span>
            <a href={base + '#temas'}>Os 12 temas</a>
            <a href={base + '#iniciativas'}>Iniciativas</a>
            <a href={base + '#dados'}>Dados</a>
            <a href={base + '#videos'}>Vídeos</a>
          </div>
          <div class="rodape__col">
            <span class="mono">Contato</span>
            <a href="mailto:idft.br@proton.me">idft.br@proton.me</a>
            <a href={base + '#canal'}>Denuncie com segurança</a>
            <a href="mailto:idft.br@proton.me?subject=Imprensa">Imprensa</a>
          </div>
        </div>
        <div class="rodape__base">
          <span>{r.base[0]}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
